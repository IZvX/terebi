#include <SDL2/SDL.h>
#include <SDL2/SDL_ttf.h>
#include <vector>
#include <functional>
#include <algorithm>
#include <cmath>
#include <string>
#include <unordered_map>
#include <iostream>

void FillRoundedBoxAA(SDL_Renderer* renderer, SDL_Rect rect, int radius, SDL_Color color) {
        if (rect.w <= 0 || rect.h <= 0) return;
        SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
        float R = std::min({(float)radius, rect.w / 2.0f, rect.h / 2.0f});
        if (R < 0) R = 0;

        // Make vectors static to re-use capacity memory across frames, preventing reallocation overhead
        static std::vector<SDL_Vertex> vertices;
        static std::vector<int> indices;
        vertices.clear();
        indices.clear();

        SDL_Vertex center_v;
        center_v.position.x = rect.x + rect.w / 2.0f;
        center_v.position.y = rect.y + rect.h / 2.0f;
        center_v.color = color;
        center_v.tex_coord = {0, 0};
        vertices.push_back(center_v);

        SDL_Color color_outer = { color.r, color.g, color.b, 0 }; 
        const float PI = 3.14159265f;
        struct Corner { float cx, cy, start_angle; };
        Corner corners[4] = {
            { rect.x + rect.w - R, rect.y + rect.h - R, 0.0f },
            { rect.x + R, rect.y + rect.h - R, PI / 2.0f },
            { rect.x + R, rect.y + R, PI },
            { rect.x + rect.w - R, rect.y + R, 3.0f * PI / 2.0f }
        };

        const int N = 20;
        for (int i = 0; i < 4; ++i) {
            for (int j = 0; j < N; ++j) {
                float angle = corners[i].start_angle + (j / (float)(N - 1)) * (PI / 2.0f);
                float nx = std::cos(angle);
                float ny = std::sin(angle);
                float px = corners[i].cx + R * nx;
                float py = corners[i].cy + R * ny;

                SDL_Vertex v_inner;
                v_inner.position.x = px;
                v_inner.position.y = py;
                v_inner.color = color;
                v_inner.tex_coord = {0.0f, 0.0f};
                vertices.push_back(v_inner);
                
                SDL_Vertex v_outer;
                v_outer.position.x = px + nx * 1.0f;
                v_outer.position.y = py + ny * 1.0f;
                v_outer.color = color_outer;
                v_outer.tex_coord = {0.0f, 0.0f};
                vertices.push_back(v_outer);
            }
        }

        int total_boundary_points = 4 * N;
        for (int k = 0; k < total_boundary_points; ++k) {
            int next_k = (k + 1) % total_boundary_points;
            int v_inner = 1 + k * 2;
            int v_outer = 2 + k * 2;
            int v_next_inner = 1 + next_k * 2;
            int v_next_outer = 2 + next_k * 2;

            indices.push_back(0);
            indices.push_back(v_inner);
            indices.push_back(v_next_inner);

            indices.push_back(v_inner);
            indices.push_back(v_outer);
            indices.push_back(v_next_inner);

            indices.push_back(v_next_inner);
            indices.push_back(v_outer);
            indices.push_back(v_next_outer);
        }
        SDL_RenderGeometry(renderer, nullptr, vertices.data(), vertices.size(), indices.data(), indices.size());
    }